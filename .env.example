# Copiar a .env y completar. NUNCA subir .env al repositorio.
ANTHROPIC_API_KEY=your_api_key_here
DATABASE_URL=sqlite:///./solicitudes.db

# Opcionales (tienen valor por defecto en app/core/config.py)
#
# CLAUDE_MODEL: por defecto claude-sonnet-5.
#   claude-opus-5    → solo para tareas complejas (hoy no aplica a este servicio)
#   claude-haiku-4-5 → más barato, útil para ejecutar las pruebas en bucle
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_MAX_TOKENS=1024
